# Blue PSL 10K — Rex theme
# =========================
# Eye-friendly pastels. Unapologetically posh. Blue PSL 10K brings the spice.
#
# Rex imports a Ghostty theme or an iTerm color file. This is that file.
# Light only. Do not add a dark variant.
#
# Import:
#   Settings → Theme → Import, and choose this file
#   or, with Remote Control on:
#   rex -C CLIENT do client.theme.import path="$PWD/rex/blue-psl-10k"
#
# Then select it for light appearance. Leave the dark theme alone.
#
# Source: https://github.com/jmcombs/blue-psl-10k
# Palette: palette/palette.json

# Background and foreground (Catppuccin Latte base/text)
background = eff1f5
foreground = 4c4f69

# Cursor (Catppuccin Latte rosewater)
cursor-color = dc8a78
cursor-text = eff1f5

# Selection (GitHub Light inspired)
selection-background = a9c1e2
selection-foreground = 24292f

# ANSI Colors (0-7: normal, 8-15: bright)
# Color 4 (blue) uses #3465a4 for ls directory consistency

# Black (Latte subtext1 / subtext0)
palette = 0=#5c5f77
palette = 8=#6c6f85

# Red (Latte red)
palette = 1=#d20f39
palette = 9=#d20f39

# Green (Latte green)
palette = 2=#40a02b
palette = 10=#40a02b

# Yellow (Latte yellow)
palette = 3=#df8e1d
palette = 11=#df8e1d

# Blue (Custom path blue - NOT Latte blue)
palette = 4=#3465a4
palette = 12=#3465a4

# Magenta (Latte pink)
palette = 5=#ea76cb
palette = 13=#ea76cb

# Cyan (Latte teal)
palette = 6=#179299
palette = 14=#179299

# White (Latte surface2 / surface1)
palette = 7=#acb0be
palette = 15=#bcc0cc

# Extended palette. Ghostty's theme file stops at 15. Rex also themes
# indices 16–255 (palette.json "indexed"). 18–255 stay on Rex's xterm cube.
palette = 16=#fe640b
palette = 17=#dc8a78

# ---------------------------------------------------------------------------
# Rex chrome roles. The importer does not read these lines; Rex derives the
# chrome from the palette above. They are recorded here so the mapping stays
# explicit, and so a later Rex theme format can pick them up without inventing
# a dark theme.
#
#   accent            #3465a4   path blue (ANSI 4), not Latte blue #1e66f5
#   danger            #d20f39   Latte red
#   success           #40a02b   Latte green
#   warning           #df8e1d   Latte yellow
#   info              #179299   Latte teal
#   canvas            #eff1f5   Latte base
#   surface           #e6e9ef   Latte mantle
#   stroke            #ccd0da   Latte surface0
#   content           #4c4f69   Latte text
#   contentSecondary  #5c5f77   Latte subtext1
#   contentTertiary   #6c6f85   Latte subtext0
#   selection         #a9c1e2 / #24292f
#   cursor            #dc8a78   Latte rosewater
#
# Dim, container, and border tints are generated from those solids. Rex has no
# separate file key for them.
#
# Not theme colors, set in Rex Settings instead:
#   font family  MesloLGS Nerd Font
#   font face    Regular
#   font size    14pt
#   font thicken terminal font smoothing
#
# Required for the background to render as #eff1f5. Glass and blend
# materials wash it out toward white (measured 250/250/251 instead of
# 239/241/245). In Settings → Interface → Appearance:
#   Interface style       Classic
#   Use glass for panes   off
#   Tint with theme       on
# ---------------------------------------------------------------------------
